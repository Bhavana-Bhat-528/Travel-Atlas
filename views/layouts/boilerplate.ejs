<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title : 'TravelAtlas - Community Driven Travel Knowledge Platform' %></title>
  
  <!-- Meta Descriptions for SEO -->
  <meta name="description" content="TravelAtlas is a community-driven travel platform organizing structured experiences, parking availability, best seasons, food options, crowd levels, and real reviews into single destination pages." />

  <!-- Favicon / Brand App Icons -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

  <!-- Bootstrap 5 CSS -->
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  
  <!-- FontAwesome Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
  
  <!-- Leaflet Maps CSS -->
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
  
  <!-- Custom CSS -->
  <link rel="stylesheet" href="/css/custom.css" />
</head>
<body class="d-flex flex-column min-vh-100">

  <!-- Sticky Navbar -->
  <%- include('../partials/navbar') %>

  <!-- Flash Alerts Container -->
  <%- include('../partials/flash') %>

  <!-- Main Body Content -->
  <main class="flex-grow-1">
    <%- body %>
  </main>

  <!-- Professional Startup Footer -->
  <%- include('../partials/footer') %>

  <!-- Bootstrap 5 Bundle JS -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  
  <!-- Leaflet Maps JS -->
  <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

  <!-- Global Client Configuration -->
  <script>
    window.GEOAPIFY_API_KEY = '<%- typeof geoapifyApiKey !== "undefined" ? geoapifyApiKey : "" %>';
  </script>

  <!-- Client Custom Scripts -->
  <script src="/js/counterAnimation.js"></script>
  <script src="/js/leafletMap.js"></script>
  <script src="/js/formValidation.js"></script>
</body>
</html>
