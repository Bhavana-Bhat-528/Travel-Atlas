<% layout('layouts/boilerplate') %>

<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-md-7 col-lg-6">
      <div class="card border-0 shadow-lg rounded-4 p-4 p-md-5 bg-white">
        <h3 class="fw-bold mb-4"><i class="fa-solid fa-user-pen text-primary me-2"></i> Edit Profile</h3>

        <form action="/profile/edit/me?_method=PUT" method="POST" enctype="multipart/form-data" class="needs-validation" novalidate>
          <div class="mb-3">
            <label class="form-label fw-semibold">Username <span class="text-danger">*</span></label>
            <input type="text" name="user[username]" class="form-control" value="<%= profileUser.username %>" required />
          </div>

          <div class="mb-3">
            <label class="form-label fw-semibold">Bio</label>
            <textarea name="user[bio]" class="form-control" rows="3" maxlength="300"><%= profileUser.bio %></textarea>
          </div>

          <div class="mb-4">
            <label class="form-label fw-semibold">Update Profile Photo</label>
            <input type="file" name="profileImage" class="form-control" accept="image/*" />
          </div>

          <div class="d-flex gap-3">
            <button type="submit" class="btn btn-ta-primary btn-lg px-4">Save Changes</button>
            <a href="/profile/<%= profileUser._id %>" class="btn btn-outline-secondary btn-lg px-4">Cancel</a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
