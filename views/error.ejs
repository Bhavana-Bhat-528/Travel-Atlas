<% layout('layouts/boilerplate') %>

<div class="container py-5 my-5">
  <div class="row justify-content-center">
    <div class="col-md-8 col-lg-6 text-center">
      <div class="card border-0 shadow-lg rounded-4 p-5 bg-white">
        <div class="ta-icon-wrapper icon-amber mx-auto mb-3" style="width: 70px; height: 70px; font-size: 2rem;">
          <i class="fa-solid fa-triangle-exclamation"></i>
        </div>
        <h1 class="display-5 fw-bold text-dark mb-2"><%= err.statusCode || 500 %></h1>
        <h4 class="fw-bold text-muted mb-3"><%= err.message || 'Something went wrong on our servers.' %></h4>

        <p class="text-secondary small mb-4">
          Don't worry! You can return to our home page or explore other community-contributed travel destinations.
        </p>

        <div class="d-flex justify-content-center gap-3">
          <a href="/" class="btn btn-ta-primary">
            <i class="fa-solid fa-house me-1"></i> Return Home
          </a>
          <a href="/destinations" class="btn btn-ta-secondary">
            <i class="fa-solid fa-earth-americas me-1"></i> Explore Destinations
          </a>
        </div>
      </div>
    </div>
  </div>
</div>
