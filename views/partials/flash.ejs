<div class="flash-container">
  <% if(success && success.length) { %>
    <div class="alert alert-success alert-dismissible fade show shadow-lg border-0 rounded-4" role="alert">
      <div class="d-flex align-items-center">
        <i class="fa-solid fa-circle-check fs-4 me-3 text-success"></i>
        <div><strong>Success!</strong> <%= success %></div>
      </div>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% } %>

  <% if(error && error.length) { %>
    <div class="alert alert-danger alert-dismissible fade show shadow-lg border-0 rounded-4" role="alert">
      <div class="d-flex align-items-center">
        <i class="fa-solid fa-triangle-exclamation fs-4 me-3 text-danger"></i>
        <div><strong>Attention!</strong> <%= error %></div>
      </div>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% } %>

  <% if(info && info.length) { %>
    <div class="alert alert-info alert-dismissible fade show shadow-lg border-0 rounded-4" role="alert">
      <div class="d-flex align-items-center">
        <i class="fa-solid fa-circle-info fs-4 me-3 text-info"></i>
        <div><%= info %></div>
      </div>
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% } %>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const flashAlerts = document.querySelectorAll('.flash-container .alert');
    flashAlerts.forEach(function (alert) {
      // Automatic dismissal timer after 10 seconds (10000ms)
      const dismissTimer = setTimeout(function () {
        if (alert && document.body.contains(alert)) {
          if (typeof bootstrap !== 'undefined' && bootstrap.Alert) {
            const bsAlert = bootstrap.Alert.getOrCreateInstance(alert);
            if (bsAlert) bsAlert.close();
          } else {
            alert.classList.remove('show');
            setTimeout(function () {
              if (alert && alert.parentNode) alert.parentNode.removeChild(alert);
            }, 150);
          }
        }
      }, 10000);

      // Clear timer if user manually clicks the dismiss button before 10s
      const closeBtn = alert.querySelector('.btn-close');
      if (closeBtn) {
        closeBtn.addEventListener('click', function () {
          clearTimeout(dismissTimer);
        });
      }
    });
  });
</script>
