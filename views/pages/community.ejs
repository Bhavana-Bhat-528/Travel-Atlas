<% layout('layouts/boilerplate') %>

<div class="container py-5">
  <div class="row justify-content-center">
    <div class="col-lg-10">
      
      <!-- Page Header -->
      <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 mb-4 bg-white">
        <div class="d-flex align-items-center gap-3 mb-3">
          <div class="ta-icon-wrapper icon-emerald fs-3 mb-0">
            <i class="fa-solid fa-users-rays"></i>
          </div>
          <div>
            <span class="badge bg-emerald-subtle text-emerald rounded-pill px-3 py-1 fw-semibold small">Community Standards</span>
            <h1 class="fw-bold display-6 mb-0 mt-1">Community Guidelines</h1>
          </div>
        </div>
        <p class="text-muted mb-0 fs-6">
          Our core principles for maintaining helpful, accurate, and respectful travel knowledge for everyone.
        </p>
      </div>

      <!-- Content Card -->
      <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5 bg-white">
        <div class="row g-4">

          <div class="col-md-6">
            <div class="ta-card h-100 p-4 border border-light-subtle">
              <div class="ta-icon-wrapper icon-emerald mb-3">
                <i class="fa-solid fa-circle-check fs-4"></i>
              </div>
              <h5 class="fw-bold text-dark">1. Share Firsthand Experiences</h5>
              <p class="text-secondary small mb-0">
                Post reviews, travel tips, and ratings based on actual, recent visits. Firsthand insights on parking, crowd levels, and road conditions help future travelers plan smoothly.
              </p>
            </div>
          </div>

          <div class="col-md-6">
            <div class="ta-card h-100 p-4 border border-light-subtle">
              <div class="ta-icon-wrapper icon-blue mb-3">
                <i class="fa-solid fa-magnifying-glass-location fs-4"></i>
              </div>
              <h5 class="fw-bold text-dark">2. Avoid Duplicate Locations</h5>
              <p class="text-secondary small mb-0">
                Search before adding a new location. Centralizing all reviews, photos, and ratings on one canonical page keeps knowledge organized and easy to digest.
              </p>
            </div>
          </div>

          <div class="col-md-6">
            <div class="ta-card h-100 p-4 border border-light-subtle">
              <div class="ta-icon-wrapper icon-amber mb-3">
                <i class="fa-solid fa-lightbulb fs-4"></i>
              </div>
              <h5 class="fw-bold text-dark">3. Provide Actionable Travel Tips</h5>
              <p class="text-secondary small mb-0">
                Include practical details such as ticket booking windows, mandatory gear (e.g. lifejackets), morning fog warnings, or nearby food availability.
              </p>
            </div>
          </div>

          <div class="col-md-6">
            <div class="ta-card h-100 p-4 border border-light-subtle">
              <div class="ta-icon-wrapper icon-purple mb-3">
                <i class="fa-solid fa-tree fs-4"></i>
              </div>
              <h5 class="fw-bold text-dark">4. Respect Nature & Local Culture</h5>
              <p class="text-secondary small mb-0">
                Encourage Leave-No-Trace principles, proper waste disposal, wildlife safety precautions, and respect for religious/temple customs.
              </p>
            </div>
          </div>

          <div class="col-12 mt-4">
            <div class="p-4 rounded-4 bg-light border border-light-subtle">
              <h5 class="fw-bold text-dark mb-2"><i class="fa-solid fa-shield-heart text-success me-2"></i>Maintaining Trust</h5>
              <p class="text-secondary small mb-0">
                Contributions that violate our community standards—such as spam, abusive comments, or fake reviews—are reviewed by community moderators. Thank you for making travel better for explorers worldwide!
              </p>
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</div>
