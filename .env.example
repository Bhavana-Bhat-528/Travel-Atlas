PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/travelatlas
SESSION_SECRET=travelatlas_super_secret_session_key_2026

# Optional: Cloudinary Configuration (App works with placeholder fallbacks if unconfigured)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_KEY=your_api_key
CLOUDINARY_SECRET=your_api_secret

# Optional: Geoapify Geocoding API Key (App includes smart fallbacks for India & world landmarks if unconfigured)
GEOAPIFY_API_KEY=your_geoapify_key

NODE_ENV=development